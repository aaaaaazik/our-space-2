# Скопируйте этот файл в .env.local и подставьте значения.
# .env.local уже в .gitignore и никогда не попадёт в репозиторий.

# --- Supabase: база данных и вход ------------------------------------------
# Supabase → ваш проект → Settings → API

# Адрес проекта, вида https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Публичный ключ (publishable / anon). Он виден в браузере — это нормально:
# доступ к данным ограничивают политики Row Level Security, а не секретность ключа.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Cloudflare R2: фотографии и видео ---------------------------------------
# Cloudflare → R2 → Manage API Tokens
#
# ВНИМАНИЕ: в отличие от ключа Supabase выше, эти три значения — НАСТОЯЩИЕ
# СЕКРЕТЫ. Они дают полный доступ к вашим файлам. Никогда не публикуйте их,
# не отправляйте в переписке и не коммитьте в репозиторий.

# Идентификатор аккаунта: он же в адресе endpoint,
# https://<ЭТА_ЧАСТЬ>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Имя корзины (bucket), например our-space-media
R2_BUCKET=
